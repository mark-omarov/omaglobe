{
  "name": "@omanow/web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "omanow website and Cloudflare Worker",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/copy-core.mjs",
    "dev": "pnpm build && wrangler dev",
    "demo": "pnpm build && wrangler dev --persist-to .wrangler/demo --var DEMO:1 --var PUBLISH_SECONDS:3",
    "reset": "node -e \"require('node:fs').rmSync('.wrangler/state', { recursive: true, force: true })\"",
    "test": "node --test",
    "deploy": "pnpm build && wrangler deploy",
    "dev:solo": "pnpm build && wrangler dev --var MIN_PER_CITY:1 --var PUBLISH_SECONDS:5"
  },
  "dependencies": {
    "@omanow/core": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  }
}
